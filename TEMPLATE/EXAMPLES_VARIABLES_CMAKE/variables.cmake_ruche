# Variables to set for Ruche
set(ENV{CC} "icc")
set(ENV{CXX} "icpc")
set(ENV{FC} "mpiifx")
set(RUN_PRE_PROC "srun")
set(PROC_CALL "--ntasks=")
set(RUN_POST_PROC "--job-name=regression_SFEMaNS --time=00:20:00 --partition=cpu_short")
set(release_bounds "-O3")
set(debug_bounds "-O2 -g -traceback -heap-arrays -check bounds -warn all")
set(SFEMaNS_DIR "/gpfs/users/norec/SFEMaNS_GIT/SFEMaNS")
set(ADDITIONAL_LINKS "-lmetis -lz")
#### Metis real kind = 8 on RUCHE
set(METIS_REAL_KIND 8)
#set(METIS_REAL_KIND 4)

## MODULES TO LOAD in your .bashrc
#module purge
#module load petsc/3.25.2/intel-oneapi-compilers-2025.3.1-intel-oneapi-mpi
#module load intel-oneapi-compilers/2025.3.1/none-none
