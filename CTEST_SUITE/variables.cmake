# Variables for personal laptop
set(SFEMaNS_DIR "/gpfs/workdir/botezv/SFEMaNS_V6/SFEMaNS")
#set(debug_bounds "$ENV(FFLAGS) -O2 -g -traceback -heap-arrays")
#set(debug_bounds "-Wall -fbounds-check -fimplicit-none -O0 -ffree-line-length-none")

set(compil "intel")
#set(compil "gnu")
if (${compil} STREQUAL gnu)
    set(debug_bounds "-Wall -fimplicit-none -fbounds-check")
    set(release_bounds "-O3 -ffree-line-length-none -fallow-argument-mismatch")
    MESSAGE(STATUS "Selected compilation with GNU")
    set(ENV{CC} "gcc-11")
    set(ENV{CXX} "g++-11")
    set(ENV{FC} "gfortran")
elseif(${compil} STREQUAL intel)
    set(release_bounds "-O3 -ffree-line-length-none")
    set(debug_bounds "-g -Wall -fbounds-check -O0 -check all -warn all -traceback")
    MESSAGE(STATUS "Selected compilation with Intel")
    #set(ENV{CC} "mpiicx")
    #set(ENV{CXX} "mpiicpx")
    #    set(ENV{FC} "mpiifx")
    set(ENV{CC} "icc")
    set(ENV{CXX} "icpc")
    set(ENV{FC} "mpiifx")

else()
    MESSAGE(FATAL_ERROR "compiler selected unavailable")
endif()

